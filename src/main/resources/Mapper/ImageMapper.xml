<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lwl.social_media_platform.mapper.ImageMapper">


    <select id="getImageList" resultType="com.lwl.social_media_platform.domain.pojo.Image">
        select *
        from image
        where treads_id = #{treadId}
    </select>
</mapper>
