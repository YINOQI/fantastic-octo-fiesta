        <result property="pic" column="pic"/>
        <result property="nickName" column="nickname"/>
        <result property="isFollow" column="is_follow"/>
        <result property="isSupport" column="is_support"/>

        <!-- 嵌套集合 -->
        <collection property="tagList" ofType="com.lwl.social_media_platform.domain.pojo.Tag" column="tag_list">
            <id property="id" column="tag_id"/>
            <result property="name" column="tag_name"/>
        </collection>
        <collection property="imageList" ofType="com.lwl.social_media_platform.domain.pojo.Image" column="image_list">
            <id property="id" column="image_id"/>
            <result property="url" column="image_url"/>
        </collection>
    </resultMap>


