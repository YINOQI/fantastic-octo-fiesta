    <select id="getTreadsVoPage" resultType="com.lwl.social_media_platform.domain.vo.TreadsVo">
        SELECT
        t.*,
        u.pic AS pic,
        u.nickname AS nickname,
        CASE WHEN f.id IS NOT NULL THEN 1 ELSE 0 END AS is_follow,
        CASE WHEN s.id IS NOT NULL THEN 1 ELSE 0 END AS is_support
        FROM
        treads t
        LEFT JOIN treads_tag tt ON t.id = tt.treads_id
        LEFT JOIN tag tg ON tt.tag_id = tg.id
        LEFT JOIN image im ON t.id = im.treads_id
        LEFT JOIN user u ON t.user_id = u.id
        LEFT JOIN concentration f ON f.user_id = #{userId} AND f.to_user_id = t.user_id
        LEFT JOIN support s ON s.user_id = #{userId} AND s.treads_id = t.id
--         where t.user_id = f.to_user_id
        <where>
            <if test="followId eq 'true' ">
                AND t.user_id = f.to_user_id
            </if>
        </where>
        GROUP BY t.id
    </select>

